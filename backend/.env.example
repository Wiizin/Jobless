# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql+asyncpg://jobless:jobless@localhost:5432/jobless

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384

STAGE1_SIMILARITY_THRESHOLD=0.35
STAGE2_MIN_SCORE=50

# National employment agency API
AGENCY_API_BASE_URL=
AGENCY_API_KEY=

# Adzuna-style aggregator
AGGREGATOR_API_BASE_URL=https://api.adzuna.com/v1/api
AGGREGATOR_APP_ID=
AGGREGATOR_APP_KEY=

# Public ATS boards — comma-separated tokens/slugs
ATS_BOARDS_GREENHOUSE_SLUGS=
ATS_BOARDS_LEVER_SLUGS=

COLLECTION_INTERVAL_MINUTES=60
DEDUP_FUZZY_THRESHOLD=90

SESSION_SECRET=dev-secret-change-me

GENERATED_DOCS_DIR=./generated_docs
